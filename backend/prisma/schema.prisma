generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InquiryStatus {
  PENDING
  IN_REVIEW
  CONTACTED
  ARCHIVED
}

model Inquiry {
  id          String        @id @default(uuid())
  name        String
  email       String
  company     String?
  phone       String?
  projectType String
  budget      String
  message     String
  status      InquiryStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}
